---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/dm-sans';
import '@/styles/global.css';
import { localePath, useTranslations, type Locale } from '@/i18n';

interface Props {
    title: string;
    description: string;
    locale: Locale;
}

const { title, description, locale } = Astro.props;
const t = useTranslations(locale);
const site = Astro.site!;
const base = import.meta.env.BASE_URL;
const canonical = new URL(localePath(locale), site).href;
const urlEs = new URL(localePath('es'), site).href;
const urlEn = new URL(localePath('en'), site).href;
const ogLocale = locale === 'es' ? 'es_MX' : 'en_US';
const ogAlternate = locale === 'es' ? 'en_US' : 'es_MX';

const personId = new URL('#manuel', canonical).href;
const jsonLd = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'Person',
            '@id': personId,
            name: 'Manuel Carretero',
            jobTitle: t.footer.role,
            url: canonical,
            email: t.contact.email,
            knowsLanguage: ['es', 'en'],
            sameAs: [
                'https://www.linkedin.com/in/manuel-sanchez-a-carretero-2b43801bb/',
                'https://github.com/Erzihark'
            ]
        },
        {
            '@type': 'ProfessionalService',
            name: 'Manuel Carretero',
            description,
            url: canonical,
            founder: { '@id': personId },
            areaServed: [
                { '@type': 'Country', name: 'Mexico' },
                { '@type': 'Country', name: 'United States' }
            ],
            availableLanguage: ['es', 'en'],
            hasOfferCatalog: {
                '@type': 'OfferCatalog',
                name: t.services.title,
                itemListElement: t.services.items.map((item) => ({
                    '@type': 'Offer',
                    itemOffered: { '@type': 'Service', name: item.title, description: item.does }
                }))
            }
        }
    ]
};
---

<!doctype html>
<html lang={locale}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="es" href={urlEs} />
        <link rel="alternate" hreflang="en" href={urlEn} />
        <link rel="alternate" hreflang="x-default" href={urlEs} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Manuel Carretero" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={t.meta.ogDescription} />
        <meta property="og:url" content={canonical} />
        <meta property="og:locale" content={ogLocale} />
        <meta property="og:locale:alternate" content={ogAlternate} />
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={t.meta.ogDescription} />
        <meta name="theme-color" content="#07090D" />
        <link rel="icon" href={`${base}favicon.ico`} sizes="32x32" />
        <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
        <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
        <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16x16.png`} />
        <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
        <link rel="manifest" href={`${base}site.webmanifest`} />
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
        <script is:inline define:vars={{ homeEs: localePath('es'), homeEn: localePath('en') }}>
            // First visit: choose the language from the timezone. A manual choice always wins.
            (function () {
                var KEY = 'lang';
                function save(v) {
                    try {
                        localStorage.setItem(KEY, v);
                    } catch (e) {}
                }
                function load() {
                    try {
                        return localStorage.getItem(KEY);
                    } catch (e) {
                        return null;
                    }
                }

                // Save the language when the visitor clicks a language link
                document.addEventListener('click', function (e) {
                    var a = e.target.closest && e.target.closest('a[hreflang]');
                    var l = a && a.getAttribute('hreflang');
                    if (l === 'es' || l === 'en') save(l);
                });

                // Spanish zones: Mexico, Spain, Spanish-speaking South America
                var ES_PREFIX = ['America/Argentina/'];
                var ES_ZONES = [
                    // Mexico
                    'America/Mexico_City', 'America/Cancun', 'America/Merida', 'America/Monterrey',
                    'America/Chihuahua', 'America/Ciudad_Juarez', 'America/Ojinaga', 'America/Hermosillo',
                    'America/Mazatlan', 'America/Tijuana', 'America/Bahia_Banderas', 'America/Matamoros',
                    // Spain
                    'Europe/Madrid', 'Africa/Ceuta', 'Atlantic/Canary',
                    // South America
                    'America/Bogota', 'America/Caracas', 'America/Lima', 'America/Santiago',
                    'America/Punta_Arenas', 'America/La_Paz', 'America/Guayaquil', 'Pacific/Galapagos',
                    'America/Asuncion', 'America/Montevideo', 'America/Buenos_Aires', 'America/Cordoba',
                    'America/Mendoza', 'America/Catamarca', 'America/Jujuy', 'America/Rosario'
                ];

                function detect() {
                    var tz = '';
                    try {
                        tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
                    } catch (e) {}
                    if (tz) {
                        var hit =
                            ES_ZONES.indexOf(tz) !== -1 ||
                            ES_PREFIX.some(function (p) {
                                return tz.indexOf(p) === 0;
                            });
                        return hit ? 'es' : 'en';
                    }
                    // No timezone: use the browser language
                    var lang = (navigator.languages && navigator.languages[0]) || navigator.language || '';
                    return /^es/i.test(lang) ? 'es' : 'en';
                }

                // Redirect only from the Spanish home page, and never for crawlers
                if (location.pathname !== homeEs) return;
                if (/bot|crawl|spider|slurp|lighthouse/i.test(navigator.userAgent)) return;
                var saved = load();
                var lang = saved === 'es' || saved === 'en' ? saved : detect();
                if (lang === 'en') location.replace(homeEn + location.search + location.hash);
            })();
        </script>
        <slot name="head" />
    </head>
    <body>
        <a class="skip-link" href="#main">
            {t.skip}
        </a>
        <slot name="header" />
        <main id="main">
            <slot />
        </main>
        <slot name="footer" />
    </body>
</html>

<style is:global>
    .skip-link {
        position: fixed;
        top: var(--space-2);
        left: var(--space-2);
        z-index: var(--z-skip);
        padding: var(--space-3) var(--space-4);
        border-radius: var(--radius-sm);
        background: var(--color-accent);
        color: var(--color-on-accent);
        font-weight: 600;
        transform: translateY(-200%);
    }
    .skip-link:focus {
        transform: none;
    }
</style>
