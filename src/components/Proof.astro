---
import { useTranslations, type Locale } from '@/i18n';
import SectionHead from './SectionHead.astro';

interface Props {
    locale: Locale;
}

const t = useTranslations(Astro.props.locale);
const p = t.proof;
---

<section
    id="resultados"
    class="section"
    aria-labelledby="proof-title"
    data-section="resultados"
    data-crocky-line={t.crocky.sections.resultados}
>
    <div class="container">
        <SectionHead id="proof-title" tag={p.tag} title={p.title} sub={p.sub} />
        <div
            class="carousel"
            data-carousel
            data-reveal
            role="region"
            aria-roledescription="carousel"
            aria-labelledby="proof-title"
        >
            <ul class="track" data-track>
                {
                    p.items.map((item, i) => (
                        <li
                            role="group"
                            aria-roledescription="slide"
                            aria-label={`${i + 1} ${p.slideOf} ${p.items.length}`}
                        >
                            <article class="card hud" data-crocky={t.crocky.proofSay} tabindex="0">
                                <p class="tag">{String(i + 1).padStart(2, '0')} / {String(p.items.length).padStart(2, '0')}</p>
                                <p class="org">{item.org}</p>
                                <p class="kind">{item.kind}</p>
                                <h3>{item.headline}</h3>
                                <p class="text">{item.text}</p>
                                <ul class="facts">
                                    {item.facts.map((f) => (
                                        <li>{f}</li>
                                    ))}
                                </ul>
                            </article>
                        </li>
                    ))
                }
            </ul>
            <div class="controls">
                <div class="bar" aria-hidden="true"><span data-bar></span></div>
                <button type="button" class="nav" data-prev aria-label={p.prev}>
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
                </button>
                <button type="button" class="nav" data-next aria-label={p.next}>
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
                </button>
            </div>
        </div>
    </div>
</section>

<style>
    .carousel {
        --gap: var(--space-4);
    }
    .track {
        display: flex;
        gap: var(--gap);
        overflow-x: auto;
        overscroll-behavior-x: contain;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
        /* Room for the focus ring and hover border */
        padding: 6px;
        margin: -6px;
        scroll-padding-inline: 6px;
    }
    .track::-webkit-scrollbar {
        display: none;
    }
    /* Without JS, keep a thin scrollbar as a hint */
    .carousel:not([data-ready]) .track {
        scrollbar-width: thin;
        padding-bottom: var(--space-4);
    }
    .track > li {
        display: flex;
        flex: 0 0 calc((100% - var(--gap) * 0.1) / 1.1);
        scroll-snap-align: start;
    }
    .controls {
        display: none;
        align-items: center;
        gap: var(--space-2);
        margin-top: var(--space-6);
    }
    .carousel[data-ready] .controls {
        display: flex;
    }
    .bar {
        flex: 1;
        height: 1px;
        margin-right: var(--space-3);
        background: var(--color-border);
    }
    .bar span {
        display: block;
        width: 100%;
        height: 100%;
        background: var(--color-accent);
        transform-origin: left;
        transform: scaleX(0.04);
        transition: transform var(--dur-fast) var(--ease-out);
    }
    .nav {
        display: grid;
        place-items: center;
        width: 2.5rem;
        height: 2.5rem;
        color: var(--color-text);
        background: transparent;
        border: 1px solid var(--color-border);
        cursor: pointer;
        transition:
            border-color var(--dur-fast) var(--ease-out),
            color var(--dur-fast) var(--ease-out);
    }
    .nav svg {
        fill: none;
        stroke: currentColor;
        stroke-width: 1.5;
    }
    .nav:hover:not(:disabled),
    .nav:focus-visible {
        color: var(--color-accent);
        border-color: var(--color-accent);
    }
    .nav:disabled {
        opacity: 0.35;
        cursor: default;
    }
    .card {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        width: 100%;
        padding: var(--space-6);
        background: var(--color-surface);
        transition: border-color var(--dur-fast) var(--ease-out);
    }
    .card:hover,
    .card:focus-visible {
        border-color: var(--color-accent);
    }
    .org {
        font-family: var(--font-heading);
        font-size: var(--text-lg);
        font-weight: 700;
    }
    .kind {
        color: var(--color-text-muted);
        font-size: var(--text-sm);
    }
    h3 {
        margin-top: var(--space-3);
        color: var(--color-accent);
        font-size: var(--text-lg);
        line-height: 1.15;
    }
    .text {
        font-size: var(--text-sm);
    }
    .facts {
        display: grid;
        gap: var(--space-2);
        margin-top: auto;
        padding-top: var(--space-4);
        color: var(--color-text-muted);
        font-size: var(--text-sm);
    }
    .facts li {
        position: relative;
        padding-left: var(--space-4);
    }
    .facts li::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0.7em;
        width: 6px;
        height: 1px;
        background: var(--color-accent);
    }
    @media (min-width: 48rem) {
        .track > li {
            flex-basis: calc((100% - var(--gap)) / 2);
        }
    }
    @media (min-width: 64rem) {
        .track > li {
            flex-basis: calc((100% - var(--gap) * 1.3) / 2.3);
        }
    }
</style>

<script>
    // Auto-sliding carousel. Cards stay static HTML; this only moves the track.
    const LOOP_MIN_ITEMS = 6; // fewer cards: stop at the last one
    const DELAY = 4500; // ms between slides
    const IDLE_PAUSE = 8000; // ms to wait after user input

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function init(root: HTMLElement) {
        const track = root.querySelector<HTMLElement>('[data-track]')!;
        const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
        const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
        const bar = root.querySelector<HTMLElement>('[data-bar]')!;
        const items = Array.from(track.children) as HTMLElement[];
        const loop = items.length >= LOOP_MIN_ITEMS;
        const behavior: ScrollBehavior = reduced ? 'auto' : 'smooth';

        let inView = false;
        let focused = false;
        let pausedUntil = 0;
        let timer: number | undefined;

        const max = () => track.scrollWidth - track.clientWidth;
        const overflow = () => max() > 2;
        const atStart = () => track.scrollLeft <= 2;
        const atEnd = () => track.scrollLeft >= max() - 2;
        const left = (el: HTMLElement) => el.offsetLeft - items[0].offsetLeft;
        const goTo = (x: number) => track.scrollTo({ left: x, behavior });

        function step(dir: 1 | -1) {
            const x = track.scrollLeft;
            if (dir === 1) {
                if (atEnd()) {
                    if (loop) goTo(0);
                    return;
                }
                const target = items.find((el) => left(el) > x + 2);
                goTo(target ? Math.min(left(target), max()) : max());
            } else {
                if (atStart()) {
                    if (loop) goTo(max());
                    return;
                }
                const target = [...items].reverse().find((el) => left(el) < x - 2);
                goTo(target ? left(target) : 0);
            }
        }

        function update() {
            const m = max();
            const canMove = overflow();
            prev.disabled = !canMove || (!loop && atStart());
            next.disabled = !canMove || (!loop && atEnd());
            const ratio = m > 0 ? track.scrollLeft / m : 1;
            bar.style.transform = `scaleX(${Math.max(ratio, 0.04)})`;
        }

        function tick() {
            if (reduced || !inView || focused || !overflow()) return;
            if (Date.now() < pausedUntil) return;
            step(1);
        }

        // Timeout chain: each run schedules the next while in view
        function stop() {
            window.clearTimeout(timer);
            timer = undefined;
        }

        function schedule() {
            stop();
            if (!inView || reduced) return;
            timer = window.setTimeout(() => {
                tick();
                schedule();
            }, DELAY);
        }

        const touch = () => {
            pausedUntil = Date.now() + IDLE_PAUSE;
        };

        // Run only while in view. On exit, jump to the first card.
        new IntersectionObserver(
            ([entry]) => {
                inView = entry.isIntersecting;
                if (inView) {
                    schedule();
                    return;
                }
                stop();
                pausedUntil = 0;
                if (track.scrollLeft > 0) {
                    track.scrollTo({ left: 0, behavior: 'instant' });
                    update();
                }
            },
            { threshold: 0.25 }
        ).observe(root);

        track.addEventListener('scroll', update, { passive: true });
        new ResizeObserver(update).observe(track);

        track.addEventListener('focusin', () => (focused = true));
        track.addEventListener('focusout', () => (focused = false));
        ['pointerdown', 'wheel', 'touchstart', 'keydown'].forEach((ev) =>
            track.addEventListener(ev, touch, { passive: true })
        );

        prev.addEventListener('click', () => {
            touch();
            step(-1);
        });
        next.addEventListener('click', () => {
            touch();
            step(1);
        });

        root.setAttribute('data-ready', '');
        update();
    }

    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(init);
</script>
