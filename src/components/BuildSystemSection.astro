---
import { useTranslations, type Locale } from '@/i18n';
import SectionHead from './SectionHead.astro';
import BuildSystem from './BuildSystem.vue';

interface Props {
    locale: Locale;
}

const t = useTranslations(Astro.props.locale);
---

<section
    id="arma-tu-sistema"
    class="section"
    aria-labelledby="build-title"
    data-section="arma-tu-sistema"
    data-crocky-line={t.crocky.sections['arma-tu-sistema']}
>
    <div class="container">
        <SectionHead id="build-title" tag={t.build.tag} title={t.build.title} sub={t.build.sub} />
        <BuildSystem client:visible t={t.build} />
    </div>
</section>
