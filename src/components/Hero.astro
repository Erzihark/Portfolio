---
import { useTranslations, type Locale } from '@/i18n';
import HeroStage from './HeroStage.vue';

interface Props {
    locale: Locale;
}

const t = useTranslations(Astro.props.locale);
const items = t.services.items.map(({ title, say }) => ({ title, say }));
---

<section
    id="inicio"
    class="hero"
    aria-labelledby="hero-title"
    data-section="inicio"
    data-crocky-line={t.crocky.sections.inicio}
>
    <div class="inner container">
        <div class="copy">
            <p class="eyebrow tag">{t.hero.eyebrow}</p>
            <h1 id="hero-title">{t.hero.title}</h1>
            <p class="lead">{t.hero.text}</p>
            <p class="ctas">
                <a class="btn btn-primary" href="#contacto" data-crocky={t.hero.ctaSay1}>
                    {t.hero.primary}
                </a>
                <a class="btn" href="#como-trabajo" data-crocky={t.hero.ctaSay2}>
                    {t.hero.secondary}
                </a>
            </p>
            <ul class="points">
                {t.hero.points.map((point) => <li>{point}</li>)}
            </ul>
        </div>
        <HeroStage
            client:idle
            items={items}
            ariaLabel={t.hero.stageAria}
            fallback={t.hero.stageFallback}
            stepsLabel={t.hero.stepsLabel}
            stageSay={t.hero.stageSay}
        />
    </div>
</section>

<style>
    .hero {
        position: relative;
        padding-block: calc(var(--header-height) + var(--space-8)) var(--space-12);
    }
    .inner {
        display: grid;
        gap: var(--space-6);
    }
    .copy {
        position: relative;
        z-index: 2;
        max-width: 36rem;
    }
    .eyebrow {
        color: var(--color-accent);
    }
    h1 {
        margin-top: var(--space-3);
        font-size: clamp(2rem, 1.1rem + 3.3vw, 3.5rem);
        line-height: var(--leading-tight);
        letter-spacing: -0.02em;
    }
    .lead {
        margin-top: var(--space-4);
        color: var(--color-text-muted);
        font-size: var(--text-lg);
    }
    .ctas {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3);
        margin-top: var(--space-6);
    }
    .btn {
        display: inline-flex;
        align-items: center;
        min-height: 48px;
        padding: 0 var(--space-6);
        border: 1px solid var(--color-border);
        background: var(--color-bg);
        color: var(--color-text);
        font-weight: 600;
        text-decoration: none;
        transition: border-color var(--dur-fast) var(--ease-out);
    }
    .btn:hover {
        border-color: var(--color-accent);
    }
    .btn-primary {
        border-color: var(--color-accent);
        background: var(--color-accent);
        color: var(--color-on-accent);
    }
    .points {
        display: grid;
        gap: var(--space-2);
        margin-top: var(--space-6);
        color: var(--color-text-muted);
        font-size: var(--text-sm);
    }
    .points li {
        position: relative;
        padding-left: var(--space-4);
    }
    .points li::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0.7em;
        width: 6px;
        height: 1px;
        background: var(--color-accent);
    }

    /* The island parts live inside the island, so these rules use :global. */
    .hero :global(.hero-stage) {
        height: clamp(340px, 56vw, 520px);
        margin-inline: calc(var(--gutter) * -1);
    }

    @media (min-width: 900px) and (max-width: 1279px) {
        .inner {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            column-gap: var(--space-6);
            align-items: start;
        }
        .copy {
            grid-column: 1;
            grid-row: 1;
        }
        .hero :global(.hero-stage) {
            grid-column: 2;
            grid-row: 1;
            height: 460px;
            margin: 0;
            border: 1px solid var(--color-border);
        }
        .hero :global(.hero-dock) {
            grid-column: 1 / -1;
            grid-row: 2;
            padding-right: 11rem;
        }
    }

    /* Wide: the stage fills the hero, behind the text. */
    @media (min-width: 1280px) {
        .hero {
            min-height: max(820px, 100svh);
        }
        .inner {
            display: block;
        }
        .hero :global(.hero-stage) {
            position: absolute;
            inset: 0;
            height: auto;
            margin: 0;
            border: 0;
        }
        .hero :global(.hero-dock) {
            position: absolute;
            left: 50%;
            bottom: 8.5rem;
            width: min(
                calc(100% - 2 * var(--gutter)),
                calc(var(--container-max) - 2 * var(--gutter))
            );
            padding-right: 11rem;
            transform: translateX(-50%);
        }
    }
</style>
