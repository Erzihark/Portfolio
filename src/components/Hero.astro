---
import { useTranslations, type Locale } from '@/i18n';

interface Props {
    locale: Locale;
}

const t = useTranslations(Astro.props.locale);
---

<section class="hero" aria-labelledby="hero-title">
    <div class="inner">
        <div class="text">
            <p class="eyebrow" data-reveal>
                {t.hero.eyebrow}
            </p>
            <h1 id="hero-title" data-reveal>
                {t.hero.title}
            </h1>
            <p class="lead" data-reveal>
                {t.hero.text}
            </p>
            <div class="ctas" data-reveal>
                <a class="btn btn-primary" href="#contacto">
                    {t.hero.primary}
                </a>
                <a class="btn btn-secondary" href="#proyectos">
                    {t.hero.secondary}
                </a>
            </div>
            <ul class="points" data-reveal>
                {t.hero.points.map((point) => (
                    <li>{point}</li>
                ))}
            </ul>
        </div>
        <!-- The 3D canvas mounts here later. The box keeps its size. -->
        <div class="scene" id="hero-scene" aria-hidden="true"></div>
    </div>
</section>

<style>
    .hero {
        display: flex;
        align-items: center;
        min-height: 100dvh;
        padding-block: calc(var(--header-height) + var(--space-8)) var(--space-12);
    }
    .inner {
        display: grid;
        gap: var(--space-8);
        width: 100%;
        max-width: var(--container-max);
        margin-inline: auto;
        padding-inline: var(--gutter);
    }
    .text {
        min-width: 0;
    }
    .eyebrow {
        margin-bottom: var(--space-4);
        color: var(--color-accent);
        font-size: var(--text-sm);
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }
    h1 {
        font-size: var(--text-hero);
        font-weight: 700;
        line-height: var(--leading-tight);
        letter-spacing: -0.02em;
        text-wrap: balance;
        overflow-wrap: break-word;
    }
    .lead {
        max-width: 38rem;
        margin-top: var(--space-6);
        color: var(--color-text-muted);
        font-size: var(--text-lg);
    }
    .ctas {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3);
        margin-top: var(--space-8);
    }
    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 3rem;
        padding: var(--space-3) var(--space-6);
        border: 2px solid transparent;
        border-radius: var(--radius-full);
        font-weight: 600;
        text-align: center;
        text-decoration: none;
        transition:
            transform var(--dur-fast) var(--ease-out),
            background-color var(--dur-fast) var(--ease-out),
            border-color var(--dur-fast) var(--ease-out);
    }
    .btn:hover {
        transform: translateY(-2px);
    }
    .btn-primary {
        background: var(--color-accent);
        color: var(--color-on-accent);
    }
    .btn-secondary {
        border-color: var(--color-border);
        color: var(--color-text);
    }
    .btn-secondary:hover {
        border-color: var(--color-accent);
    }
    .points {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2) var(--space-6);
        margin-top: var(--space-8);
        color: var(--color-text-muted);
        font-size: var(--text-sm);
    }
    .points li {
        display: flex;
        align-items: center;
        gap: var(--space-2);
    }
    .points li::before {
        content: '';
        width: 0.5rem;
        height: 0.5rem;
        border-radius: var(--radius-full);
        background: var(--color-accent-2);
    }
    .scene {
        width: min(100%, 70vh);
        aspect-ratio: 1;
        margin-inline: auto;
        border-radius: var(--radius-lg);
        background: radial-gradient(
            circle at 50% 50%,
            var(--color-accent-glow) 0%,
            transparent 60%
        );
    }
    @media (min-width: 64rem) {
        .inner {
            grid-template-columns: 1.1fr 0.9fr;
            align-items: center;
            gap: var(--space-12);
        }
    }
</style>
